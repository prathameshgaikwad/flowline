# Provider selection: auto | meta | openrouter | fake
LLM_PROVIDER=auto

# Meta Model API (preferred)
META_API_KEY=
# Alias accepted by the factory:
# MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# OpenCode Console / OpenCode Go (OpenAI-compatible; exposes Muse Spark 1.3)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_MODEL=muse-spark-1.3

# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Meta model through OpenRouter's fallback path
OPENROUTER_MODEL=meta/muse-spark-1.3

# Agent limits
AGENT_MAX_ITERATIONS=12
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
