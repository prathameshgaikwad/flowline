# Provider selection: auto | meta | openrouter | fake
LLM_PROVIDER=auto

# Meta Model API (preferred)
META_API_KEY=
# Alias accepted by the factory:
# MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# OpenCode Console / OpenCode Go (OpenAI-compatible; exposes Muse Spark 1.3)
# console = pay-as-you-go credits; go = $10 Go subscription (endpoint /inference/go/openai/v1)
OPENCODE_PLAN=console
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
# Console default: muse-spark-1.3. Go default: muse-spark-1.3-contributor.
# The Go Contributor model requires "Allow paid endpoints that train on request data"
# in OpenCode Console -> Settings -> Privacy. Use only non-confidential demo data.
OPENCODE_MODEL=
# Optional: read the key from the OpenCode CLI auth file instead of copying it.
OPENCODE_CLI_AUTH=false
OPENCODE_AUTH_FILE=
OPENCODE_AUTH_PROVIDER=

# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Meta model through OpenRouter's fallback path
OPENROUTER_MODEL=meta/muse-spark-1.3

# Agent limits
AGENT_MAX_ITERATIONS=12
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
